{
  "expo": {
    "name": "Connect Four",
    "slug": "connect-four-android",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Connect Four to scan a connection QR code.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Connect Four to access photos so you can scan a QR code.",
          "microphonePermission": false
        }
      ],
      "@config-plugins/react-native-webrtc",
      "expo-sharing",
      "expo-asset"
    ],
    "android": {
      "package": "com.connectfour.passandplay",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    }
  }
}
